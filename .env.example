# Copy to .env.local for local development. Nothing here is required to run the demo locally.

# Public URL of the deployment (used for auth callbacks, sitemap, Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database. Leave unset locally to use embedded Postgres (PGlite) in .data/.
# Production: a Postgres URL, e.g. Neon or Azure Database for PostgreSQL.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# AUTO_MIGRATE=true

# Auth (required in production). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional SSO
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Live models (Team plan workspaces). Without these, runs use the deterministic rules model.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# Override model pricing for cost tracking (USD per million tokens)
# MODEL_INPUT_USD_PER_MTOK=
# MODEL_OUTPUT_USD_PER_MTOK=

# Billing (Stripe). Team plan price, metered overage price, meter event name, webhook secret.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_TEAM=
# STRIPE_PRICE_OVERAGE=
# STRIPE_METER_EVENT_NAME=assay_triage_run
# STRIPE_WEBHOOK_SECRET=

# Operations
# CRON_SECRET=              # protects /api/cron/rollup
# ADMIN_EMAILS=you@example.com   # can view /admin/leads
# LEAD_WEBHOOK_URL=         # optional: POST pilot requests to Slack/Zapier
